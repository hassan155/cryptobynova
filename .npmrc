# NOVA wrote this file, and it is why `npm install` works here.
#
# This project pins lucide-react at 0.330.0 on purpose: it is the last release
# carrying the brand logos (GitHub, LinkedIn, X, ...) that the icons in this site
# import by name. Later versions dropped them, so moving off 0.330.0 breaks the
# icons rather than fixing anything.
#
# lucide-react 0.330.0 declares support for React 16-18, and this project is on
# React 19. npm treats that as an unresolvable conflict and refuses to install.
# In practice the icons work fine on React 19 — the declared range is simply out
# of date — so this tells npm to install anyway.
#
# If you remove this line, `npm install` will fail with ERESOLVE. Use
# `npm install --legacy-peer-deps` instead, or put this line back.
legacy-peer-deps=true
